# Documentation-only Phase 0 environment catalog. Never commit real secrets.
APP_ENV=development
APP_NAME=KrishiMitra AI
API_VERSION=v1
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_DB=krishimitra
POSTGRES_USER=krishimitra
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+asyncpg://krishimitra:replace-with-local-password@db:5432/krishimitra

AWS_REGION=ap-south-1
AWS_S3_BUCKET_DOCUMENTS=replace-with-documents-bucket-name
AWS_S3_BUCKET_IMAGES=replace-with-images-bucket-name
AWS_COGNITO_USER_POOL_ID=replace-with-user-pool-id
AWS_COGNITO_CLIENT_ID=replace-with-app-client-id
AWS_COGNITO_ADMIN_GROUP=administrators
JWT_JWKS_CACHE_SECONDS=3600

GEMINI_API_KEY=replace-with-local-secret
GEMINI_SECRET_ARN=
GEMINI_MODEL=select-stable-gemini-flash-model-at-implementation-time
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20
RAG_MIN_RELEVANCE_THRESHOLD=0.20
RAG_VECTOR_WEIGHT=0.65
RAG_LEXICAL_WEIGHT=0.35

LOG_LEVEL=INFO
IMAGE_MAX_BYTES=10485760
PRESIGNED_UPLOAD_TTL_SECONDS=900
CHAT_RATE_LIMIT_PER_MINUTE=20
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# For a physical phone, replace localhost with the development machine LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Production workloads should use EC2/Lambda IAM roles and an AWS-compatible
# secrets manager. Do not add static AWS access keys to tracked files.
