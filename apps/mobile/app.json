{
  "expo": {
    "name": "KrishiMitra AI",
    "slug": "krishimitra-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KrishiMitra to select a crop photo for analysis.",
          "cameraPermission": "Allow KrishiMitra to photograph a crop for analysis.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.krishimitra.mobile"
    },
    "android": {
      "package": "ai.krishimitra.mobile"
    }
  }
}
